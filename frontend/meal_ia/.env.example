# Flutter App Environment Configuration Example
# Duplicate this file as .env and fill in your values. DO NOT commit .env to Git.

# Backend API Configuration (Optional: defaults to production Render URL if omitted)
# BACKEND_URL=http://10.0.2.2:8000

# Stripe (Publishable Key for Mobile SDK)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Firebase Project Configuration
PROJECT_ID=your-firebase-project-id
MESSAGING_SENDER_ID=your-messaging-sender-id
STORAGE_BUCKET=your-project.firebasestorage.app
AUTH_DOMAIN=your-project.firebaseapp.com

# Android Configuration
ANDROID_API_KEY=your-android-api-key
ANDROID_APP_ID=1:your-project-number:android:your-app-id
ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# Google Sign-In Server Client ID
GOOGLE_SERVER_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Gemini AI (Food Scanner)
GEMINI_API_KEY=your-gemini-api-key

# Other Platforms (Web, iOS, macOS, Windows)
WEB_API_KEY=your-web-api-key
WEB_APP_ID=1:your-project-number:web:your-app-id
IOS_API_KEY=your-ios-api-key
IOS_APP_ID=1:your-project-number:ios:your-app-id
IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
IOS_BUNDLE_ID=com.example.mealIa
MACOS_API_KEY=your-macos-api-key
MACOS_APP_ID=your-macos-app-id
WINDOWS_API_KEY=your-windows-api-key
WINDOWS_APP_ID=your-windows-app-id
