# Backend Environment Configuration Example
# Duplicate this file as .env and fill in your values. DO NOT commit .env to Git.

# OpenAI API Key (For AI meal and nutrition plan generation)
OPENAI_API_KEY=your-openai-api-key-here

# JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=your-random-jwt-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Stripe Payments (Secret Key)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Google Sign-In Client IDs
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com

# Database URL (Optional: defaults to local SQLite mealia.db if omitted)
# SQLALCHEMY_DATABASE_URL=sqlite:///./mealia.db
